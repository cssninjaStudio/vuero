{
  "name": "app-ssr",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tsx server/serve.ts",
    "build": "run-s build:update-bulma-colors build:client build:server",
    "build:update-bulma-colors": "bulma-css-vars",
    "build:client": "cross-env NODE_ENV=production vite build --ssrManifest --outDir dist/client",
    "build:server": "cross-env NODE_ENV=production vite build --ssr src/entry-server.ts --outDir dist/server",
    "generate": "run-s build:update-bulma-colors generate:build",
    "generate:build": "NODE_ENV=production cross-env tsx server/generate.ts",
    "start": "cross-env NODE_ENV=production tsx server/serve.ts",
    "test": "run-p test:*",
    "test:tsc": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@cssninja/bulma-css-vars": "0.9.3",
    "@fontsource-variable/fira-code": "5.2.5",
    "@fontsource-variable/montserrat": "5.2.5",
    "@fontsource-variable/roboto-flex": "5.2.5",
    "@nuxt/devalue": "2.0.2",
    "@unhead/addons": "2.0.3",
    "@unhead/ssr": "2.0.3",
    "@unhead/vue": "2.0.3",
    "@vueuse/core": "13.0.0",
    "@vueuse/router": "13.0.0",
    "bulma": "npm:@cssninja/bulma@0.9.4",
    "compression": "1.8.0",
    "cross-env": "7.0.3",
    "defu": "6.1.4",
    "focus-trap": "7.6.4",
    "focus-trap-vue": "4.0.3",
    "h3": "1.15.1",
    "html-minifier-terser": "7.2.0",
    "iconify-icon": "2.3.0",
    "listhen": "1.9.0",
    "npm-run-all": "4.1.5",
    "picocolors": "1.1.1",
    "pinia": "3.0.1",
    "serve-static": "2.2.0",
    "std-env": "3.8.1",
    "tslib": "2.8.1",
    "tsx": "4.19.3",
    "ufo": "1.5.4",
    "unhead": "2.0.3",
    "universal-cookie": "8.0.1",
    "unplugin-vue-router": "0.12.0",
    "vee-validate": "4.15.0",
    "vue": "3.5.13",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@types/compression": "1.7.5",
    "@types/html-minifier-terser": "7.0.2",
    "@types/node": "22.13.17",
    "@types/serve-static": "1.15.7",
    "@vitejs/plugin-vue": "5.2.3",
    "@vueuse/integrations": "13.0.0",
    "fast-glob": "3.3.3",
    "rollup-plugin-purgecss": "7.0.2",
    "sass": "1.75.0",
    "typescript": "5.8.2",
    "unplugin-auto-import": "19.1.2",
    "unplugin-vue-components": "28.4.1",
    "vite": "6.2.4",
    "vite-plugin-vue-devtools": "7.7.2",
    "vue-tsc": "2.2.8",
    "youch": "4.1.0-beta.6"
  }
}
