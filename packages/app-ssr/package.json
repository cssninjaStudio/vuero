{
  "name": "app-ssr",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tsx server/serve.ts",
    "build": "run-s build:update-bulma-colors build:client build:server",
    "build:update-bulma-colors": "bulma-css-vars",
    "build:client": "cross-env NODE_ENV=production vite build --ssrManifest --outDir dist/client",
    "build:server": "cross-env NODE_ENV=production vite build --ssr src/entry-server.ts --outDir dist/server",
    "generate": "run-s build:update-bulma-colors generate:build",
    "generate:build": "NODE_ENV=production cross-env tsx server/generate.ts",
    "start": "cross-env NODE_ENV=production tsx server/serve.ts",
    "test": "run-p test:*",
    "test:tsc": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@cssninja/bulma-css-vars": "0.9.2",
    "@fontsource-variable/fira-code": "5.1.0",
    "@fontsource-variable/montserrat": "5.1.0",
    "@fontsource-variable/roboto-flex": "5.1.0",
    "@nuxt/devalue": "2.0.2",
    "@unhead/addons": "1.11.6",
    "@unhead/ssr": "1.11.6",
    "@unhead/vue": "1.11.6",
    "@vueuse/core": "11.1.0",
    "@vueuse/router": "11.1.0",
    "bulma": "npm:@cssninja/bulma@0.9.4",
    "compression": "1.7.4",
    "cross-env": "7.0.3",
    "defu": "6.1.4",
    "focus-trap": "7.6.0",
    "focus-trap-vue": "4.0.3",
    "h3": "1.12.0",
    "html-minifier-terser": "7.2.0",
    "iconify-icon": "2.1.0",
    "listhen": "1.8.0",
    "npm-run-all": "4.1.5",
    "picocolors": "1.1.0",
    "pinia": "2.2.2",
    "serve-static": "1.16.2",
    "std-env": "3.7.0",
    "tslib": "2.7.0",
    "tsx": "4.19.1",
    "ufo": "1.5.4",
    "unhead": "1.11.6",
    "universal-cookie": "7.2.0",
    "unplugin-vue-router": "0.10.8",
    "vee-validate": "4.13.2",
    "vue": "3.5.10",
    "vue-router": "4.4.5"
  },
  "devDependencies": {
    "@types/compression": "1.7.5",
    "@types/html-minifier-terser": "7.0.2",
    "@types/node": "22.7.4",
    "@types/serve-static": "1.15.7",
    "@vitejs/plugin-vue": "5.1.4",
    "@vueuse/integrations": "11.1.0",
    "fast-glob": "3.3.2",
    "rollup-plugin-purgecss": "6.0.0",
    "sass": "npm:sass-embedded@1.75.0",
    "typescript": "5.6.2",
    "unplugin-auto-import": "0.18.3",
    "unplugin-vue-components": "0.27.4",
    "vite": "5.4.8",
    "vite-plugin-vue-devtools": "7.4.6",
    "vue-tsc": "2.1.6"
  }
}
