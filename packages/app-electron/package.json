{
  "name": "app-electron",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main/index.js",
  "author": {
    "name": "cssninjaStudio <hello@cssninja.io> (https://cssninja.io)"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-s build:update-bulma-colors build:client build:electron",
    "build:update-bulma-colors": "bulma-css-vars",
    "build:client": "rimraf dist-electron && cross-env NODE_ENV=production vite build",
    "build:electron": "electron-builder build",
    "start": "cross-env NODE_ENV=production serve dist -s -p 5000",
    "test": "run-p test:*",
    "test:tsc": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@cssninja/bulma-css-vars": "0.9.2",
    "@fontsource-variable/fira-code": "5.1.0",
    "@fontsource-variable/montserrat": "5.1.0",
    "@fontsource-variable/roboto-flex": "5.1.0",
    "@unhead/addons": "1.11.10",
    "@unhead/ssr": "1.11.10",
    "@unhead/vue": "1.11.10",
    "@vueuse/core": "11.1.0",
    "@vueuse/router": "11.1.0",
    "bulma": "npm:@cssninja/bulma@0.9.4",
    "defu": "6.1.4",
    "focus-trap": "7.6.0",
    "focus-trap-vue": "4.0.3",
    "iconify-icon": "2.1.0",
    "npm-run-all": "4.1.5",
    "pinia": "2.2.4",
    "rimraf": "6.0.1",
    "serve": "14.2.4",
    "tslib": "2.8.0",
    "ufo": "1.5.4",
    "unhead": "1.11.10",
    "unplugin-vue-router": "0.10.8",
    "vee-validate": "4.14.6",
    "vue": "3.5.12",
    "vue-router": "4.4.5"
  },
  "devDependencies": {
    "@types/node": "22.8.2",
    "@vitejs/plugin-vue": "5.1.4",
    "cross-env": "7.0.3",
    "electron": "33.0.2",
    "electron-builder": "25.1.8",
    "rollup-plugin-purgecss": "6.0.0",
    "sass": "npm:sass-embedded@1.75.0",
    "terser": "5.36.0",
    "typescript": "5.6.3",
    "unplugin-auto-import": "0.18.3",
    "unplugin-vue-components": "0.27.4",
    "vite": "5.4.10",
    "vite-plugin-electron": "0.28.8",
    "vite-plugin-electron-renderer": "0.14.6",
    "vite-plugin-vue-devtools": "7.5.4",
    "vue-tsc": "2.1.8"
  }
}
