    "unhead": "1.9.7",
    "universal-cookie": "7.1.4",
    "unplugin-vue-router": "0.8.6",
    "v-calendar": "3.0.3",
    "vee-validate": "4.12.6",
    "vivus": "0.4.6",
    "vue": "3.4.25",
    "vue-accessible-color-picker": "5.0.1",
