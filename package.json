{
  "name": "vuero",
  "version": "0.0.1-dev",
  "private": "true",
  "license": "MIT",
  "scripts": {
    "postinstall": "node ./scripts/skip.js || husky install",
    "dev": "vite",
    "build": "run-s build:*",
    "build:clean": "rimraf dist",
    "build:vite": "vite build",
    "lint": "run-s lint:js lint:style lint:prettier",
    "lint:fix": "run-s lint:js:fix lint:style:fix lint:prettier:fix",
    "lint:prettier": "prettier --check \"./src/**/*.(js|ts|vue|css|scss|graphql|gql)\"",
    "lint:prettier:fix": "prettier --write \"./src/**/*.(js|ts|vue|css|scss|graphql|gql)\"",
    "lint:js": "eslint --ext .ts,.vue ./src",
    "lint:js:fix": "eslint --fix --ext .ts,.vue ./src",
    "lint:style": "stylelint ./src/**/*.{vue,css,scss}",
    "lint:style:fix": "stylelint ./src/**/*.{vue,css,scss} --fix",
    "test:e2e": "cypress",
    "precommit": "run-s precommit:*",
    "precommit:lint-staged": "lint-staged"
  },
  "dependencies": {
    "@iconify/iconify": "1.0.7",
    "@vueform/multiselect": "^1.2.5",
    "@vueuse/core": "4.0.10",
    "@vueuse/head": "^0.2.3",
    "apexcharts": "^3.23.1",
    "axios": "0.21.1",
    "billboard.js": "^2.2.0",
    "bulma": "0.9.2",
    "dayjs": "^1.10.4",
    "markdown-it-emoji": "^2.0.0",
    "notyf": "^3.9.0",
    "nprogress": "0.2.0",
    "simplebar": "6.0.0-beta.9",
    "simplebar-vue": "^1.6.0",
    "vue": "3.0.5",
    "vue-i18n": "9.0.0-rc.2",
    "vue-router": "4.0.3",
    "vue-scrollto": "^2.20.0",
    "vue-toastification": "2.0.0-rc.1",
    "vue3-apexcharts": "^1.1.1"
  },
  "devDependencies": {
    "@iconify/json": "1.1.292",
    "@intlify/vite-plugin-vue-i18n": "1.0.0-beta.12",
    "@purge-icons/generated": "^0.6.0",
    "@types/markdown-it": "^12.0.1",
    "@types/node": "14.14.22",
    "@types/nprogress": "0.2.0",
    "@types/prismjs": "^1.16.2",
    "@types/simplebar": "5.1.1",
    "@typescript-eslint/eslint-plugin": "4.14.1",
    "@typescript-eslint/parser": "4.14.1",
    "@vitejs/plugin-vue": "1.1.2",
    "@vue/compiler-sfc": "3.0.5",
    "@vue/server-renderer": "3.0.5",
    "@vuedx/typecheck": "0.6.3",
    "@vuedx/typescript-plugin-vue": "0.6.3",
    "autoprefixer": "^10.2.3",
    "chalk": "^4.1.0",
    "cross-env": "7.0.3",
    "cypress": "^6.3.0",
    "eslint": "7.18.0",
    "eslint-config-prettier": "7.2.0",
    "eslint-plugin-prettier-vue": "3.0.0-alpha.2",
    "eslint-plugin-vue": "7.5.0",
    "gray-matter": "^4.0.2",
    "husky": "^5.0.6",
    "lint-staged": "^10.5.3",
    "markdown-it": "^12.0.4",
    "markdown-it-anchor": "^7.0.0",
    "npm-run-all": "4.1.5",
    "prettier": "2.2.1",
    "prismjs": "^1.23.0",
    "rimraf": "3.0.2",
    "rollup": "^2.37.1",
    "sass": "1.32.5",
    "stylelint": "13.9.0",
    "stylelint-config-prettier": "8.0.2",
    "stylelint-config-standard": "20.0.0",
    "stylelint-scss": "3.18.0",
    "tiny-slider": "^2.9.3",
    "typescript": "4.1.3",
    "vite": "2.0.0-beta.50",
    "vite-plugin-components": "0.6.6",
    "vite-plugin-fonts": "0.1.5",
    "vite-plugin-md": "^0.4.0",
    "vite-plugin-pages": "^0.1.4",
    "vite-plugin-purge-icons": "0.6.0",
    "vite-plugin-pwa": "^0.4.1",
    "vite-plugin-voie": "^0.7.3",
    "vite-ssg": "0.5.1",
    "voie-pages": "^0.4.0",
    "yorkie": "^2.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.scss": [
      "stylelint",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
