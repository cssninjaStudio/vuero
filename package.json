{
  "name": "frontend",
  "version": "0.0.0",
  "private": "true",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "typecheck . && vite build",
    "eslint": "eslint",
    "lint:prettier": "prettier --check --ignore-path .gitignore \"./src/**/*.(js|ts|vue|css|sass|scss|graphql|gql)\"",
    "lint:prettier:fix": "prettier --write --ignore-path .gitignore \"./src/**/*.(js|ts|vue|css|sass|scss|graphql|gql)\"",
    "lint:js": "eslint --ext .js,.ts,.vue --ignore-path .gitignore ./src",
    "lint:js:fix": "eslint --fix --ext .js,.ts,.vue --ignore-path .gitignore ./src",
    "lint:style": "stylelint ./src/**/*.{vue,css,sass,scss} --ignore-path .gitignore",
    "lint:style:fix": "stylelint ./src/**/*.{vue,css,sass,scss} --fix --ignore-path .gitignore",
    "lint": "npm run lint:js && npm run lint:style && npm run lint:prettier",
    "lint:fix": "npm run lint:js:fix && npm run lint:style:fix && npm run lint:prettier:fix"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^5.15.1",
    "@zhuowenli/vue-feather-icons": "^5.0.2",
    "axios": "^0.21.0",
    "bulma": "^0.9.1",
    "dayjs": "^1.9.7",
    "vue": "^3.0.4",
    "vue-router": "^4.0.1",
    "vue-toastification": "^2.0.0-beta.8",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@types/webfontloader": "^1.6.32",
    "@typescript-eslint/eslint-plugin": "^4.7.0",
    "@typescript-eslint/parser": "^4.7.0",
    "@vue/compiler-sfc": "^3.0.4",
    "eslint": "^7.13.0",
    "eslint-config-prettier": "^7.0.0",
    "eslint-plugin-prettier-vue": "^3.0.0-alpha.2",
    "eslint-plugin-vue": "^7.1.0",
    "prettier": "^2.1.2",
    "sass": "^1.29.0",
    "stylelint": "^13.7.2",
    "stylelint-config-prettier": "^8.0.2",
    "stylelint-config-standard": "^20.0.0",
    "stylelint-scss": "^3.18.0",
    "typescript": "^4.0.3",
    "vite": "^1.0.0-rc.13"
  }
}
