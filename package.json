{
  "name": "vuro",
  "version": "0.0.1-dev",
  "private": "true",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "typecheck . && vite build",
    "eslint": "eslint",
    "lint:prettier": "prettier --check --ignore-path .gitignore \"./src/**/*.(js|ts|vue|css|scss|graphql|gql)\"",
    "lint:prettier:fix": "prettier --write --ignore-path .gitignore \"./src/**/*.(js|ts|vue|css|scss|graphql|gql)\"",
    "lint:js": "eslint --ext .js,.ts,.vue --ignore-path .gitignore ./src",
    "lint:js:fix": "eslint --fix --ext .js,.ts,.vue --ignore-path .gitignore ./src",
    "lint:style": "stylelint ./src/**/*.{vue,css,scss} --ignore-path .gitignore",
    "lint:style:fix": "stylelint ./src/**/*.{vue,css,scss} --fix --ignore-path .gitignore",
    "lint": "npm run lint:js && npm run lint:style && npm run lint:prettier",
    "lint:fix": "npm run lint:js:fix && npm run lint:style:fix && npm run lint:prettier:fix"
  },
  "dependencies": {
    "@vueuse/core": "^4.0.0-rc.8",
    "@iconify/iconify": "^1.0.7",
    "axios": "^0.21.0",
    "bulma": "^0.9.1",
    "dayjs": "^1.9.7",
    "nprogress": "^0.2.0",
    "vue": "^3.0.4",
    "vue-router": "^4.0.1",
    "vue-toastification": "^2.0.0-beta.8",
    "webfontloader": "^1.6.28"
  },
  "devDependencies": {
    "@iconify/json": "^1.1.274",
    "@purge-icons/generated": "^0.4.1",
    "@types/nprogress": "^0.2.0",
    "@types/webfontloader": "^1.6.32",
    "@typescript-eslint/eslint-plugin": "^4.7.0",
    "@typescript-eslint/parser": "^4.7.0",
    "@vue/compiler-sfc": "^3.0.4",
    "@vuedx/typescript-plugin-vue": "^0.2.3",
    "eslint": "^7.13.0",
    "eslint-config-prettier": "^7.0.0",
    "eslint-plugin-prettier-vue": "^3.0.0-alpha.2",
    "eslint-plugin-vue": "^7.1.0",
    "prettier": "^2.1.2",
    "sass": "^1.29.0",
    "stylelint": "^13.7.2",
    "stylelint-config-prettier": "^8.0.2",
    "stylelint-config-standard": "^20.0.0",
    "stylelint-scss": "^3.18.0",
    "typescript": "^4.0.3",
    "vite": "^1.0.0-rc.13",
    "vite-plugin-components": "^0.5.0",
    "vite-plugin-purge-icons": "^0.4.5",
    "vite-plugin-voie": "^0.4.1",
    "voie-pages": "^0.4.0"
  }
}
