{
  "name": "vuero",
  "version": "0.0.1-dev",
  "private": "true",
  "license": "MIT",
  "scripts": {
    "postinstall": "node ./scripts/skip.js || husky install",
    "dev": "vite --force",
    "preview": "vite preview",
    "build": "run-s build:*",
    "build:clean": "rimraf dist",
    "build:vite": "vite build",
    "lint:fix": "run-s lint:eslint:fix lint:stylelint:fix lint:prettier:fix lint:doc:fix",
    "lint:prettier": "prettier --check \"./src/**/*.(js|ts|vue|css|scss|graphql|gql)\"",
    "lint:prettier:fix": "prettier --write \"./src/**/*.(js|ts|vue|css|scss|graphql|gql)\"",
    "lint:eslint": "eslint --ext .ts,.vue ./src",
    "lint:eslint:fix": "eslint --fix --ext .ts,.vue ./src",
    "lint:stylelint": "stylelint ./src/**/*.{vue,css,scss}",
    "lint:stylelint:fix": "stylelint ./src/**/*.{vue,css,scss} --fix",
    "lint:doc:fix": "run-s lint:doc:*",
    "lint:doc:eslint": "eslint --fix --ext .md ./documentation",
    "lint:doc:prettier": "prettier --write \"./documentation/**/*.(md)\"",
    "test:check": "vuedx-typecheck .",
    "test:lint": "run-s lint:eslint lint:stylelint lint:prettier",
    "test:e2e": "cypress run",
    "precommit": "run-s precommit:*",
    "precommit:lint-staged": "lint-staged"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-build-classic": "^25.0.0",
    "@ckeditor/ckeditor5-vue": "^2.0.1",
    "@iconify/iconify": "1.0.7",
    "@popperjs/core": "^2.6.0",
    "@vueform/multiselect": "1.3.2",
    "@vueform/slider": "^1.0.3",
    "@vueuse/core": "4.0.12",
    "@vueuse/head": "0.2.3",
    "apexcharts": "3.24.0",
    "axios": "0.21.1",
    "billboard.js": "2.2.2",
    "bulma": "0.9.2",
    "dayjs": "1.10.4",
    "markdown-it-emoji": "2.0.0",
    "notyf": "3.9.0",
    "nprogress": "0.2.0",
    "photoswipe": "^4.1.3",
    "simple-datatables": "^3.0.0",
    "simplebar": "6.0.0-beta.9",
    "simplebar-vue": "1.6.0",
    "tippy.js": "^6.2.7",
    "v-calendar": "3.0.0-alpha.3",
    "vue": "3.0.5",
    "vue-i18n": "9.0.0-rc.2",
    "vue-router": "4.0.3",
    "vue-scrollto": "2.20.0",
    "vue-tippy": "^6.0.0-alpha.24",
    "vue3-apexcharts": "1.2.1"
  },
  "devDependencies": {
    "@iconify/json": "^1.1.298",
    "@intlify/vite-plugin-vue-i18n": "1.0.0-beta.15",
    "@types/markdown-it": "12.0.1",
    "@types/node": "14.14.25",
    "@types/nprogress": "0.2.0",
    "@types/prismjs": "1.16.2",
    "@types/simplebar": "5.1.1",
    "@typescript-eslint/eslint-plugin": "4.14.2",
    "@typescript-eslint/parser": "4.14.2",
    "@vitejs/plugin-vue": "1.1.4",
    "@vue/compiler-sfc": "3.0.5",
    "@vue/server-renderer": "3.0.5",
    "@vuedx/typecheck": "0.6.3",
    "@vuedx/typescript-plugin-vue": "0.6.3",
    "cross-env": "7.0.3",
    "cypress": "6.4.0",
    "eslint": "7.19.0",
    "eslint-config-prettier": "7.2.0",
    "eslint-plugin-md": "^1.0.19",
    "eslint-plugin-prettier-vue": "3.0.0-alpha.2",
    "eslint-plugin-vue": "7.5.0",
    "gray-matter": "4.0.2",
    "husky": "5.0.6",
    "lint-staged": "10.5.4",
    "markdown-it": "12.0.4",
    "markdown-it-anchor": "7.0.1",
    "npm-run-all": "4.1.5",
    "plyr": "^3.6.4",
    "prettier": "2.2.1",
    "prismjs": "1.23.0",
    "rimraf": "3.0.2",
    "rollup": "2.38.5",
    "sass": "1.32.6",
    "stylelint": "13.9.0",
    "stylelint-config-prettier": "8.0.2",
    "stylelint-config-standard": "20.0.0",
    "stylelint-scss": "3.18.0",
    "tiny-slider": "2.9.3",
    "typescript": "4.1.3",
    "vite": "2.0.0-beta.65",
    "vite-plugin-components": "0.6.6",
    "vite-plugin-fonts": "0.1.5",
    "vite-plugin-md": "0.4.2",
    "vite-plugin-purge-icons": "0.6.0",
    "vite-plugin-pwa": "0.4.3",
    "vite-plugin-voie": "0.7.3",
    "voie-pages": "0.4.0",
    "yorkie": "2.0.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.scss": [
      "stylelint",
      "prettier --write"
    ],
    "*.md": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
